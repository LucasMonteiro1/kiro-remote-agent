# --- Local hub server (talks only to the Kiro Remote Bridge IDE extension) ---
# Local port the WebSocket hub listens on. Only the Kiro Remote Bridge
# extension connects here (same machine, ws://127.0.0.1:<port>) — nothing
# about this is exposed to the internet; Discord is the remote client now.
HUB_PORT=8787

# Shared secret every Kiro Remote Bridge extension instance uses to
# authenticate to the hub. Must match kiroRemoteBridge.hubSecret in every
# IDE window's settings.
# Generate with: openssl rand -base64 48
HUB_SHARED_SECRET=

# Friendly label used only in daemon log lines (e.g. "work-macbook")
HOST_LABEL=work-pc

# --- Discord (the remote client) ---
# Bot token from the Discord Developer Portal: My Applications -> your app
# -> Bot -> Reset Token. Treat this like a password.
DISCORD_BOT_TOKEN=

# ID of the forum channel where session threads are created. Enable
# Developer Mode (User Settings -> Advanced) to get a "Copy Channel ID"
# option when you right-click the channel.
DISCORD_FORUM_CHANNEL_ID=

# Where the sessionId <-> Discord thread id mapping is persisted, so
# restarting the daemon reuses existing threads instead of creating
# duplicates every time.
DISCORD_THREAD_MAP_PATH=./discord-threads.json

# How often (ms) this daemon scans ~/.kiro/sessions to refresh its local
# cache of Kiro IDE session titles/status — used only to label newly
# created Discord threads with a real title instead of a raw session id.
SESSION_SCAN_INTERVAL_MS=45000

# --- kiro-cli ---
KIRO_CLI_BIN=kiro-cli

# Absolute path to the project/workspace kiro-cli should run in.
KIRO_PROJECT_DIR=

# Optional: resume a specific existing session by id (kiro-cli chat --resume-id).
# If unset, the daemon uses `kiro-cli chat --resume` (most recent session in
# KIRO_PROJECT_DIR).
KIRO_SESSION_ID=

# Comma-separated list of tool categories to pre-trust (no prompt shown for
# these). Leave empty to have every tool call go through the Discord
# approval flow, mirroring the Kiro IDE experience. Example: read,grep
KIRO_TRUST_TOOLS=

# Required by kiro-cli for headless/automation auth. Needs a Pro (or higher)
# plan. See: kiro.dev/docs/getting-started/authentication
KIRO_API_KEY=

# --- Approval prompt detection ---
# Regex (with an optional literal "(?i)" prefix for case-insensitive) used to
# detect when kiro-cli is showing a permission prompt in its PTY output.
# Tune this after watching DEBUG_LOG_PATH during your first real test.
APPROVAL_PROMPT_REGEX=(?i)(allow this|permission|do you want to (proceed|allow)|trust this tool|\[y/n\]|\(y/n\))

# How long (ms) of PTY silence before we consider kiro-cli's current turn
# finished and post its output to Discord as one assistant message.
IDLE_MS_BEFORE_TURN_COMPLETE=1500

# Keystrokes sent into the PTY for each Discord button decision. Defaults
# assume a simple y/n/a prompt; adjust after checking the debug log.
APPROVE_KEYSTROKES=y\r
DENY_KEYSTROKES=n\r
APPROVE_ALWAYS_KEYSTROKES=a\r

# Where to write raw PTY output + daemon logs for debugging. This file may
# contain snippets of your conversation; keep it out of git (already
# gitignored) and delete it once you're done tuning the regex above.
DEBUG_LOG_PATH=./kiro-remote-agent-debug.log
