# URL of your deployed kiro-remote-relay (Vercel), e.g. https://kiro-remote.vercel.app
RELAY_URL=

# Must match AGENT_SHARED_SECRET in the kiro-remote-relay .env.
# Generate with: openssl rand -base64 48
AGENT_SHARED_SECRET=

# Friendly label shown in the phone UI (e.g. "work-macbook")
HOST_LABEL=work-pc

# How often (ms) this daemon polls the relay for new messages/approvals.
# Every poll costs Redis commands on the relay (Upstash free tier caps at
# 500K/month), so this is intentionally not sub-second; 15s keeps this one
# daemon's share of that budget small while still feeling responsive.
POLL_INTERVAL_MS=15000

# How often (ms) this daemon scans ~/.kiro/sessions and pushes a fresh
# summary snapshot of all local Kiro IDE sessions (history + in-progress)
# to the relay, for read-only progress tracking from the phone.
SESSION_SCAN_INTERVAL_MS=60000

# --- kiro-cli ---
KIRO_CLI_BIN=kiro-cli

# Absolute path to the project/workspace kiro-cli should run in.
KIRO_PROJECT_DIR=

# Optional: resume a specific existing session by id (kiro-cli chat --resume-id).
# If unset, the daemon uses `kiro-cli chat --resume` (most recent session in
# KIRO_PROJECT_DIR).
KIRO_SESSION_ID=

# Comma-separated list of tool categories to pre-trust (no prompt shown for
# these). Leave empty to have every tool call go through the phone approval
# flow, mirroring the Kiro IDE experience. Example: read,grep
KIRO_TRUST_TOOLS=

# Required by kiro-cli for headless/automation auth. Needs a Pro (or higher)
# plan. See: kiro.dev/docs/getting-started/authentication
KIRO_API_KEY=

# --- Approval prompt detection ---
# Regex (with an optional literal "(?i)" prefix for case-insensitive) used to
# detect when kiro-cli is showing a permission prompt in its PTY output.
# Tune this after watching DEBUG_LOG_PATH during your first real test.
APPROVAL_PROMPT_REGEX=(?i)(allow this|permission|do you want to (proceed|allow)|trust this tool|\[y/n\]|\(y/n\))

# How long (ms) of PTY silence before we consider kiro-cli's current turn
# finished and push its output to the phone as one assistant_message.
IDLE_MS_BEFORE_TURN_COMPLETE=1500

# Keystrokes sent into the PTY for each phone decision. Defaults assume a
# simple y/n/a prompt; adjust after checking the debug log.
APPROVE_KEYSTROKES=y\r
DENY_KEYSTROKES=n\r
APPROVE_ALWAYS_KEYSTROKES=a\r

# Where to write raw PTY output + daemon logs for debugging. This file may
# contain snippets of your conversation; keep it out of git (already
# gitignored) and delete it once you're done tuning the regex above.
DEBUG_LOG_PATH=./kiro-remote-agent-debug.log
