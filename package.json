{
  "name": "kiro-remote-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Local daemon that bridges a kiro-cli session to a Discord bot, so you can keep chatting with your Kiro agent from your phone (via Discord) while it keeps running on your work machine.",
  "bin": {
    "kiro-remote-agent": "dist/index.js"
  },
  "scripts": {
    "postinstall": "node -e \"try{require('fs').chmodSync(require.resolve('node-pty/prebuilds/'+process.platform+'-'+process.arch+'/spawn-helper'),0o755)}catch(e){}\"",
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xterm/headless": "^6.0.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "node-pty": "^1.0.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
